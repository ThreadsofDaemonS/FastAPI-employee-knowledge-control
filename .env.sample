# Use this file to create your own .env

# ip addresses for CORS
CORS_ORIGINS=
# port for our app
PORT=

# host for our app
HOST=


# Provide the path to your db
# i.e. sqlite:///./app/db/database.db
DATABASE_URL=




# Your secret key. Make it long enough, use a combination of uppercase & lowercase letters,
# numbers and special symbols
SECRET_KEY=

# Debug mode. Use True in development. Don't forget to set to False in prod.
DEBUG=

# Postgres credentials
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_HOST=
REDIS_PORT=